{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "particle-academy/prism-labs",
    "type": "project",
    "description": "The Prism Lab - a local-only testbed that exercises Prism and its satellite packages against real provider APIs.",
    "keywords": [
        "laravel",
        "inertia",
        "react",
        "tailwind",
        "fancy-ui",
        "starter-kit"
    ],
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "../prism",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../prism-harness",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../prism-browser",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../prism-human-plus",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../prism-workspace",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../prism-mcp",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../prism-opentelemetry",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../prism-perplexity",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": "^8.4",
        "guzzlehttp/guzzle": "^8.0",
        "inertiajs/inertia-laravel": "^3.1",
        "laravel/framework": "^13.8",
        "laravel/tinker": "^3.0",
        "open-telemetry/exporter-otlp": "^1.0",
        "open-telemetry/sdk": "^1.0",
        "particle-academy/fancy-flow-php": "0.49.1",
        "particle-academy/prism": "dev-main as 0.117.2",
        "particle-academy/prism-browser": "dev-main as 0.1.0",
        "particle-academy/prism-harness": "dev-main as 0.8.0",
        "particle-academy/prism-human-plus": "dev-main as 0.1.0",
        "particle-academy/prism-mcp": "dev-main as 0.2.0",
        "particle-academy/prism-opentelemetry": "dev-main as 0.2.0",
        "particle-academy/prism-perplexity": "dev-main as 0.2.0",
        "particle-academy/prism-workspace": "dev-main as 0.2.0",
        "symfony/process": "^8.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"npm run dev\" --names='server,queue,vite'"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "particle-academy/prism-opentelemetry"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "tbachert/spi": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
