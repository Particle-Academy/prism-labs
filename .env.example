APP_NAME=Prism
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

INERTIA_SSR_ENABLED=false

# Prism Lab (local environment only)
# ---------------------------------------------------------------------------
# Providers
#
# Every provider the Lab knows about is listed, configured or not. A key you
# leave blank is not an error: the Lab reports that provider as unconfigured
# and tells you which variable to set, which is more useful than hiding it.
#
# This is the whole point of the app — the surface it can reach is the surface
# it can prove. An undocumented provider is one nobody remembers to test.
# ---------------------------------------------------------------------------

# Text
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
REQUESTY_API_KEY=
PERPLEXITY_API_KEY=
QWEN_API_KEY=
AZURE_AI_API_KEY=
Z_API_KEY=
REPLICATE_API_KEY=

# Audio and embeddings
ELEVENLABS_API_KEY=
VOYAGEAI_API_KEY=

# Ollama needs no key — it needs a running daemon. Vertex authenticates
# through Google application-default credentials rather than an API key.

# Telemetry
PRISM_TELEMETRY_ENABLED=true
PRISM_TELEMETRY_CAPTURE_CONTENT=true
PHOENIX_OTLP_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_UI_URL=http://localhost:6006
PHOENIX_PROJECT=prism-lab
