<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnRisky="true"
>
    <!--
        A RISKY TEST FAILS THE BUILD.

        PHPUnit calls a test risky when it asserts nothing, among other things —
        which is precisely the failure this ecosystem keeps finding in its own
        guards: a check that passes because it was never asked a question it
        could answer. A probe with an inverted vacuity guard, a board reporting a
        broken property green because its probe used a clean tool name, a
        detector measuring the half that was cheap to measure.

        Turning this on is the cheapest version of the mutation rule, and it
        catches the one case the mutation rule is too slow for: a test that never
        asserted anything at all. The connector-lab team lost a guard to exactly
        that this week — assertions inside a loop over an empty list — and found
        it only because PHPUnit flagged it while the flag was advisory.

        Verified green in this repository before being switched on.
    -->

    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <!-- 0L learnings are FILES, and the store writes them wherever it is
             pointed - the database being :memory: does not sandbox the disk.
             Benchmark runs now file a learning on every terminal outcome, so
             without this every `php artisan test` would drop fixture-named
             learnings ("fuse", "settlement") into the workspace knowledge base
             alongside the real ones. -->
        <env name="PRISM_LEARNINGS_PATH" value="./storage/framework/testing/learnings"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
